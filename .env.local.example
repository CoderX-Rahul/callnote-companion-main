# Copy to .env.local. Local values override the Lovable-managed tracked .env.
# Browser-visible Supabase URL and publishable (anon) key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=fieldiq-local
SUPABASE_PROJECT_ID=fieldiq-local

# Server-only Supabase values. Never add a VITE_ prefix to these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Migration and SQL-test scripts only; the application never reads this variable.
DATABASE_URL=

# Optional AI configuration. Use LOVABLE_API_KEY for the existing Lovable gateway,
# or AI_API_KEY + AI_MODEL for an OpenAI-compatible provider. Non-OpenAI endpoints
# use Chat Completions; the OpenAI endpoint uses Responses API.
LOVABLE_API_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REASONING=false
# Optional OpenAI-compatible reasoning effort (override path only; unset by default).
AI_REASONING_EFFORT=
# AI request limits apply to both gateway and override paths.
AI_TIMEOUT_MS=45000       # Per model attempt: 5000–120000
AI_MAX_RETRIES=2          # Our wrapper only; 0–4 retries (SDK retries are disabled)
AI_TOTAL_DEADLINE_MS=90000 # Whole extraction budget: 10000–180000
# Set false to disable safe duration/count-only extraction timing logs.
AI_TIMING_LOGS=true
